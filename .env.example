# =====================================================================
# CloudSentinel Environment Configuration Template
# Copy this file to .env and adjust variables for your deployment
# =====================================================================

# Application Environment (development, staging, production)
APP_ENV=development
DEBUG=false
SECRET_KEY=generate_a_secure_random_hex_key_here

# Streamlit UI Configuration
STREAMLIT_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# HTTP Telemetry Ingestion Receiver
INGESTION_API_HOST=0.0.0.0
INGESTION_API_PORT=8000

# Database Configuration (SQLite default for local; PostgreSQL for Cloud)
DATABASE_TYPE=sqlite
DATABASE_PATH=database/security.db
# POSTGRES_URL=postgresql://cloudsentinel_user:secure_password@localhost:5432/cloudsentinel_db

# Machine Learning & Storage Settings
MODELS_DIR=models
DATA_DIR=data
DEFAULT_MODEL_SELECTION_POLICY=balanced

# Outbound SMTP Alert Notifications (Optional)
EMAIL_ALERTS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@cloudsentinel.local
SMTP_PASSWORD=your_app_specific_password_here
ALERT_RECIPIENT_EMAIL=soc-analyst@cloudsentinel.local

# AWS Cloud Integration (Optional S3 model archive & CloudTrail ingestion)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=cloudsentinel-model-registry-bucket
